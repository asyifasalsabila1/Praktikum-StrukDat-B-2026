#Soal 4 – Single Linked List (Antrian Pasien)
class Node:
    def __init__(self, data):
        self.data = data
        self.next = None


class AntrianPasien:
    def __init__(self):
        self.head = None
    
    def tambah(self, data):
        node_baru = Node(data)
        
        if not self.head:
            self.head = node_baru
        else:
            current = self.head
            while current.next:
                current = current.next
            current.next = node_baru
    
    def tampilkan(self):
        print("\n===== ANTRIAN PASIEN =====")
